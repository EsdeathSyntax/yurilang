@import (
    bitutil from std
)

#entry main

public fn fast_sqrt(x: float) -> float {
    let xhalf: float = x * 0.5
    let i: int = bitutil.bitcast_to_int(x)

    i = 0x5fe6ec65457f5639 - (i >> 1)
    
    let y: float = bitutil.bitcast_to_float(i)
    
    y = y * (1.5 - (xhalf * y * y))
    y = y * (1.5 - (xhalf * y * y))
    
    return x * y
}

public fn main(x: float) -> void {

    println(x)
    println(fast_sqrt(x))
}
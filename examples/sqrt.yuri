#entry main

@import (
    [os, thread, math, io] from std
)

public fn main() -> void {
    let start_time := os.time()
    let end_time := start_time + 1000
    let count := 0
    
    while true {
        let i := 0
        while i < 10000 {
            let val := math.sqrt(2.0)
            count += 1
            i += 1
        }
        if os.time() >= end_time {
            break
        }
    }
    
    io.write(count)
}
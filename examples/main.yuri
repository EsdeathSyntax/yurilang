
#entry main

@import (
    [bitutil, math, io] from std
)


public fn calculate_physics(t: float) -> float {
    let velocity := t * 9.81 + 15.4;
    let drag := velocity / 2.5;
    return velocity - drag;
}

public fn main(x: float?) -> void {
    if x == nullptr {
        x = 0
    }
    let sequence := [1, 2, 4, 8, 16, 32, "random string", 3, 5, 6, 7, 9, 10, 11, 12, 13, 14, 15]
    io.write(sequence)

    let physics_config := {
        gravity = 981,
        friction = 2,
        mode = "advanced"
    }
    io.write(physics_config)

    let base_offset := 42;
    let computed_val := (base_offset * 2) + bitutil.bitcast_to_int(x, 1) - math.idiv(100, 4);
    
    let final_result := calculate_physics(3.14) * 2.0;
    io.write(final_result)
}